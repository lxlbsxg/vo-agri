# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.
#
# In production (e.g. Render), don't use a .env file at all — set these
# as Environment Variables in the host's dashboard instead.

# Required. Signs login session cookies; the app refuses to start without
# it. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. If unset, falls back to a local SQLite file (vo_agri.db) next
# to app.py — fine for local dev, but NOT fine on a host with an ephemeral
# filesystem (e.g. Render's free tier wipes local disk on every deploy/
# restart, which would silently delete all registered accounts and
# uploaded papers). Set this to a persistent database's connection string
# in production, e.g. a Render-managed Postgres instance:
#   postgresql://user:password@host:port/dbname
DATABASE_URL=

# Optional. Set to "1" to run Flask's own dev server in debug mode
# locally (auto-reload, interactive debugger). Leave unset in production —
# gunicorn (see Procfile) never reads this and never runs the dev server.
FLASK_DEBUG=
